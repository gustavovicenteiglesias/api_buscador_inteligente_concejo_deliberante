# --- Azure Chat Config ---
AZURE_CHAT_ENDPOINT=https://your-endpoint.openai.azure.com/
AZURE_CHAT_API_KEY=your-api-key
AZURE_CHAT_DEPLOYMENT=gpt-4
AZURE_CHAT_API_VERSION=2024-02-15-preview

# --- Azure Embedding Config ---
AZURE_EMBEDDING_ENDPOINT=https://your-endpoint.openai.azure.com/
AZURE_EMBEDDING_API_KEY=your-api-key
AZURE_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_EMBEDDING_API_VERSION=2023-05-15

# --- Weaviate Config ---
WEAVIATE_URL=http://localhost:8080
WEAVIATE_CLASS_NAME=Document

# --- App Logic Config ---
BASE_URL=https://your-site.com/pdfs/
TOP_K_DEFAULT=5
MAX_CONTEXT_CHARS=15000
UPLOAD_DIR=./uploads
CHUNK_SIZE=6000
CHUNK_OVERLAP=400
UUID_NAMESPACE=b3e1c1b0-6a7a-4b27-9f5c-3f1d7e0be0b1

# --- Server Config ---
PORT=8080
PY_LOG_LEVEL=INFO
